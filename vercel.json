{
  "rewrites": [
    {
      "source": "/api/feedback/:token",
      "destination": "/api/tickets?feedback=:token"
    },
    {
      "source": "/api/bookings/:id/reschedule",
      "destination": "/api/bookings?reschedule=:id"
    },
    {
      "source": "/api/coordinators/:id/password",
      "destination": "/api/coordinators?password=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/bookings.ts": {
      "maxDuration": 60
    },
    "api/tickets.ts": {
      "maxDuration": 60
    },
    "api/clients.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
